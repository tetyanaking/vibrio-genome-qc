/*
 * Default process resources
 * Shared by all execution environments.
 */

process {

    executor = 'local'

    errorStrategy = 'terminate'

    shell = [
        '/bin/bash',
        '-euo',
        'pipefail'
    ]

    withName: RESOLVE_SRA {
        cpus = 1
        memory = '2 GB'
        time = '1h'
    }

    withName: DOWNLOAD_READS {
        cpus = 4
        memory = '8 GB'
        time = '6h'
    }

    withName: MERGE_RUNS {
        cpus = 2
        memory = '2 GB'
        time = '30m'
    }

    withName: FETCH_ORIGINAL_ASSEMBLY {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withName: FASTP {
        cpus = 8
        memory = '8 GB'
        time = '2h'
    }

    withName: KRAKEN2 {
        cpus = 10
        memory = '28 GB'
        time = '8h'
    }

    withName: EXTRACT_VIBRIO_READS {
        cpus = 4
        memory = '8 GB'
        time = '2h'
    }

    withName: UNICYCLER {
        cpus = 8
        memory = '24 GB'
        time = '24h'
    }

    withName: COV_LENGTH_FILTER {
        cpus = 8
        memory = '16 GB'
        time = '4h'
    }

    withName: GUNC {
        cpus = 8
        memory = '20 GB'
        time = '4h'
    }

    withName: APPLY_FCS_POLICY {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }

    withName: CHECKM2 {
        cpus = 8
        memory = '16 GB'
        time = '8h'
    }

    withName: BUSCO {
        cpus = 8
        memory = '16 GB'
        time = '8h'
    }

    withName: SEQKIT_STATS {
        cpus = 2
        memory = '2 GB'
        time = '30m'
    }

    withName: SAMPLE_SUMMARY {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: CHECKM2_DELTA {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: COHORT_SUMMARY {
        cpus = 1
        memory = '1 GB'
        time = '10m'
    }

    withName: MULTIQC {
        cpus = 2
        memory = '4 GB'
        time = '30m'
    }

}
