params {

    input = "${projectDir}/data/metadata.csv"
    samplesheet = null

    outdir =
        "${projectDir}/results"

    vibrio_taxid = 662
    min_vibrio_read_pairs = 1000
    busco_lineage = 'vibrionales_odb10'
    kraken2_db = null
    busco_download_path = null
    checkm2_db = null

    // GUNC per-genome chimera + cross-clade contamination DB
    // (single ~13 GB file, `gunc download_db /path/`).
    gunc_db = null
}


env {
    BUSCO_DOWNLOAD_PATH = params.busco_download_path
}

includeConfig "${projectDir}/conf/base.config"

profiles {

    conda {
        conda {
            enabled = true
            useMamba = true
        }
        
        docker.enabled = false
        singularity.enabled = false
    }

    // NOTE: docker/singularity are not yet wired up — no process below
    // declares a `container` directive, so these profiles disable conda
    // without providing a replacement runtime. Conda is the only
    // supported execution method until container images are added.
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
    }

    singularity {
        singularity.enabled = true
        conda.enabled = true
        docker.enabled = false
    }

    local {
        includeConfig "${projectDir}/conf/local.config"
    }
}
